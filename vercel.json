{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "http://kod.publicvm.com:2618/:path*"
    }
  ],
  "functions": {
    "api/pair.js": {
      "maxDuration": 300
    },
    "api/sender-pair.js": {
      "maxDuration": 300
    },
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/dev/[...path].js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/dev/cron/health",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/dev/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}