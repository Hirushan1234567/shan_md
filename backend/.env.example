# Copy to backend/.env on the VPS. Never commit real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=3035

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/shan_api_platform?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Exact frontend origins, comma separated. Include the deployed frontend host. Do not add a trailing slash.
APP_ORIGINS=https://shanmd.vercel.app

ADMIN_NAME=SHAN API HUB Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD

# Initial coin prices; editable later in the admin panel.
PREMIUM_PLAN_COINS=500
MEMBERSHIP_PLAN_COINS=1000

# Optional database backup settings.
BACKUP_RETENTION_DAYS=14
