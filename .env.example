# Vercel Project Settings → Environment Variables
# Add real values in Vercel only. Never commit this file with real credentials.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shan_api_hub

# Admin account (reserved email + private password)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PRIVATE_PASSWORD

# Public website origin (no trailing slash)
APP_URL=https://shanmd.vercel.app

# Required only for WhatsApp pairing proxy
BOT_API_URL=https://YOUR_BOT_VPS_DOMAIN
SHAN_API_KEY=YOUR_PRIVATE_SERVER_TO_SERVER_KEY
